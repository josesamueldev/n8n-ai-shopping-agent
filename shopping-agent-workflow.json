    {
      "parameters": {
        "description": "Retorna a lista de todas as lojas cadastradas com seus nomes, endereços e coordenadas de latitude e longitude para cálculo de distância.",
        "jsCode": "// Substitua pela lista real de lojas (nome, latitude e longitude)\nconst lojas = [\n  { nome: \"Loja Exemplo Centro\", lat: -1.4550, lon: -48.4900 },\n  { nome: \"Loja Exemplo Bairro Norte\", lat: -1.4300, lon: -48.4600 },\n  { nome: \"Loja Exemplo Bairro Sul\", lat: -1.4700, lon: -48.4400 },\n];\n\nfunction haversine(lat1, lon1, lat2, lon2) {\n  const R = 6371;\n  const dLat = (lat2 - lat1) * Math.PI / 180;\n  const dLon = (lon2 - lon1) * Math.PI / 180;\n  const a = Math.sin(dLat/2)**2 +\n            Math.cos(lat1 * Math.PI/180) * Math.cos(lat2 * Math.PI/180) *\n            Math.sin(dLon/2)**2;\n  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));\n}\n\n// Pega as coordenadas passadas para a Tool (ou substitua pelos campos que a IA envia)\nconst clienteLat = parseFloat($fromAI('lat', 'Latitude do cliente'));\nconst clienteLon = parseFloat($fromAI('lon', 'Longitude do cliente'));\n\nconst comDistancia = lojas.map(loja => ({\n  ...loja,\n  distancia_km: Math.round(haversine(clienteLat, clienteLon, loja.lat, loja.lon) * 10) / 10\n}));\n\ncomDistancia.sort((a, b) => a.distancia_km - b.distancia_km);\n\n// Retorna as 3 lojas mais próximas convertidas em texto para a IA ler\nreturn JSON.stringify(comDistancia.slice(0, 3));"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        1376,
        144
      ],
      "id": "b9917f24-386d-438a-acc0-9b37f12eef51",
      "name": "Code Tool"
