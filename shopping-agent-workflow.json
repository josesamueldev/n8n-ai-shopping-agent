    {
      "parameters": {
        "toolDescription": "CARRINHO: Use quando o cliente quiser adicionar, remover ou revisar itens no carrinho de compras.",
        "method": "POST",
        "url": "=https://{{ $env.VTEX_ACCOUNT_NAME || 'SUA_LOJA' }}.vtexcommercestable.com.br/api/checkout/pub/orderForm/{{ $fromAI('orderFormId', 'ID do carrinho se já existir. Se for o primeiro item, envie vazio', 'string') || 'orderForm' }}/items?sc=3",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"orderItems\": [\n    {\n      \"id\": \"{{ $fromAI('skuId', 'ID/SKU do produto retornado na busca', 'string') }}\",\n      \"quantity\": {{ $fromAI('quantidade', 'Quantidade de itens a adicionar (padrão 1)', 'number') }},\n      \"seller\": \"1\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        1504,
        144
      ],
      "id": "9cb0c3f0-d1bf-4c42-bf13-7a1396f1b13b",
      "name": "Carrinho"
    },
    {
      "parameters": {
        "jsCode": "// Captura os dados do nó anterior usando o padrão atual do n8n\nconst inputData = $input.first().json;\n\n// Garante que 'message' nunca vá como null (se estiver vazio no teste, usa texto padrão)\nconst mensagemCliente = inputData.message || inputData.body?.message || \"Quero comprar ração\";\n\n// Sua lógica de horário (mantida 100%)\nconst agora = new Date();\nconst horaLocal = new Date(agora.toLocaleString('en-US', { timeZone: 'America/Belem' }));\nconst diaSemana = horaLocal.getDay(); // 0=domingo, 6=sábado\nconst hora = horaLocal.getHours();\nconst minuto = horaLocal.getMinutes();\nconst minutosAtuais = hora * 60 + minuto;\n\nconst horarios = {\n  0: null, // domingo fechado\n  1: { abre: 8*60, fecha: 18*60 },\n  2: { abre: 8*60, fecha: 18*60 },\n  3: { abre: 8*60, fecha: 18*60 },\n  4: { abre: 8*60, fecha: 18*60 },\n  5: { abre: 8*60, fecha: 18*60 },\n  6: { abre: 8*60, fecha: 13*60 }\n};\n\nconst horarioHoje = horarios[diaSemana];\nconst lojaAberta = Boolean(horarioHoje && minutosAtuais >= horarioHoje.abre && minutosAtuais < horarioHoje.fecha);\n\n// Corte de entrega no mesmo dia (ex: até 15h)\nconst corteEntregaMinutos = 15 * 60;\nconst aindaDaPraEntregarHoje = minutosAtuais < corteEntregaMinutos;\n\nreturn [{\n  json: {\n    ...inputData,\n    message: mensagemCliente, // <--- Corrige o erro de mensagem nula\n    loja_aberta: lojaAberta,\n    entrega_mesmo_dia_disponivel: lojaAberta && aindaDaPraEntregarHoje,\n    horario_atual: `${hora}:${String(minuto).padStart(2,'0')}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
